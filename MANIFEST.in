# Never package local deployments, credentials, generated output, or VCS state.
prune .git
prune .state
prune .venv
prune venv
prune build
prune dist
prune logs
prune backups
prune local-deployment
prune web/secrets
prune web/.venv
global-exclude *.py[cod] __pycache__
